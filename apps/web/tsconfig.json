{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // As T3 Code's web app compiles, so the primitives copied from it stay unedited: extensionless
    // `~/` imports, resolved the way Vite resolves them.
    "module": "preserve",
    "moduleResolution": "bundler",
    "erasableSyntaxOnly": false,
    "verbatimModuleSyntax": false,
    // T3 Code's packages the copies import, mapped to the copies and stand-ins under src/t3tools.
    "paths": {
      "~/*": ["./src/*"],
      "@t3tools/contracts": ["./src/lib/t3codeContracts.ts"],
      "@t3tools/contracts/settings": ["./src/lib/t3codeContracts.ts"],
      "@t3tools/shared/*": ["./src/t3tools/shared/*"],
      "@t3tools/client-runtime/composer-model-mentions": ["./src/t3tools/client-runtime/composerModelMentions.ts"],
      "@t3tools/client-runtime/*": ["./src/t3tools/client-runtime/*"],
      "@effect/atom-react": ["./src/t3tools/atom-react.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
