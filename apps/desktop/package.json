{
  "name": "@runnerbox/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "ensure:electron": "node node_modules/electron/install.js",
    "build": "node scripts/build.ts",
    "start": "electron .",
    "typecheck": "tsc -p .",
    "test": "node --test \"src/**/*.test.ts\"",
    "dist": "node scripts/build.ts && node scripts/dist.ts"
  },
  "dependencies": {
    "@runnerbox/client-runtime": "workspace:*",
    "@runnerbox/connect": "workspace:*",
    "@runnerbox/contracts": "workspace:*",
    "effect": "4.0.5",
    "electron-updater": "6.8.11",
    "semver": "7.7.4"
  },
  "devDependencies": {
    "@types/semver": "7.8.0",
    "electron": "44.10.0",
    "electron-builder": "26.16.1",
    "esbuild": "0.28.2"
  }
}
