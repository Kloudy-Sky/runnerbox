{
  "name": "runnerbox",
  "version": "0.0.0",
  "private": true,
  "description": "Throwaway GitHub Actions runners on your own hardware, with job tracking.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "runnerbox": "node src/cli.ts",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/runnerbox.js",
    "test": "node --test \"src/**/*.test.ts\" && pnpm -r test",
    "typecheck": "tsc && pnpm -r typecheck",
    "leak-check": "node scripts/leak-check.ts",
    "server": "node apps/server/src/bin.ts"
  },
  "dependencies": {
    "arktype": "2.2.9"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
