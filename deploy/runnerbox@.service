# Runs one install as a user service: systemctl --user enable --now runnerbox@<name>
# Expects a release's runnerbox.js at ~/runnerbox/runnerbox.js and its config at ~/.config/runnerbox/<name>.json.
# Run `loginctl enable-linger` once so it starts at boot without a login.
# `node` must be on the user service manager's PATH, which a version manager's shell setup doesn't reach.
# Restarting this service kills running jobs.
[Unit]
Description=runnerbox runners (%i)

[Service]
WorkingDirectory=%h/runnerbox
ExecStart=/usr/bin/env node runnerbox.js up --config %E/runnerbox/%i.json
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
